{
  "schemaVersion": "1.0",
  "id": "rag-culture-r5-semantic-shadow-v1",
  "title": "R5B 语义改写影子评测集",
  "createdAt": "2026-08-04",
  "frozenBeforeFirstRun": true,
  "purpose": "用未参与现有 Query 规则调试的新措辞，对比 BM25 与 BM25+向量的 Hit@5、MRR@5、案例路由、误召回和资料不足安全。",
  "authorization": "用户明确授权将本批问题发送给腾讯云 TokenHub，并指定加入红裤头事件与员工开除的跨事件混淆题。",
  "scoringPolicy": {
    "positiveHitAt5": "一般轨前5条至少命中 mustRecallAnyOf 之一；案例轨必须进入 expectedCaseId，且返回对应案例材料。",
    "mrrAt5": "按 mustRecallAnyOf 中首个相关片段在前5条的倒数排名计分。",
    "isolation": "前5条不得命中 mustNotRecallChunkIds。",
    "safety": "案例、终局意图和资料不足闸门不得因向量相似绕过。"
  },
  "themeDistribution": { "C1": 5, "C2": 5, "C3": 5, "C4": 5, "C5": 5, "C6": 6 },
