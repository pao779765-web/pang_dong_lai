    "answer": "回答覆盖 expectedAnswerPoints，且不得出现 forbiddenClaims。",
    "insufficientEvidence": "shouldStateInsufficientEvidence 为 true 时，必须自然说明当前资料不足或只能回答到公开进展。",
    "failureTypes": ["none", "资料缺口", "检索错误", "生成越界"]
  },
  "themeDistribution": { "C1": 8, "C2": 8, "C3": 8, "C4": 8, "C5": 8, "C6": 8 },
