# 复制本文件为 .dev.vars（同目录），填入真实 Key。
# .dev.vars 已被 Git 忽略，不会上传到 GitHub。
#
# 用法：
#   1. 复制：copy .dev.vars.example .dev.vars
#   2. 编辑 .dev.vars，把下面的值换成你的 DeepSeek API Key
#   3. 重新运行：npm run dev
#
# 注意：不要把真实 Key 写进本 example 文件，也不要提交 .dev.vars。

DEEPSEEK_API_KEY=sk-请替换为你的DeepSeek密钥

# 默认保持原来的 BM25；只有本地验证混合检索时才改为 hybrid。
RAG_RETRIEVAL_MODE=bm25

# R5 本地向量实验使用。真实密钥只写入 .dev.vars 或系统环境变量，不要提交。
TENCENT_TOKENHUB_API_KEY=请替换为你的TokenHub密钥
# 通常无需修改下面两项。
TENCENT_TOKENHUB_ENDPOINT=https://tokenhub.tencentmaas.com/v1/embeddings
TENCENT_TOKENHUB_MODEL=kinfra-text-embedding-4b
