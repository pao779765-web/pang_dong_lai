{
  "name": "pangdonglai-culture-museum",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "knowledge:build": "node scripts/build-knowledge.mjs",
    "rag:evaluate": "npm run knowledge:build && node scripts/evaluate-rag-baseline.mjs --current",
    "predev": "npm run knowledge:build",
    "dev": "vinext dev",
    "prebuild": "npm run knowledge:build",
    "build": "vinext build",
    "prestart": "npm run knowledge:build",
    "start": "node scripts/start.mjs",
    "prestart:cloudbase": "npm run knowledge:build",
    "start:cloudbase": "node scripts/cloudbase-server.mjs",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "prelint": "npm run knowledge:build",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
